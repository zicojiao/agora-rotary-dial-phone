# Agora project credentials — https://console.agora.io
# App ID is public by design; the certificate must stay server-side.
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# UID the Conversational AI agent joins the RTC channel with.
# Optional — defaults to 123456 when unset.
NEXT_PUBLIC_AGENT_UID=123456

# Fish Audio TTS key that gives the agent its voice — https://fish.audio
FISH_AUDIO_API_KEY=

# HMAC secret signing the call tickets that bind the three API routes
# together. Generate with: openssl rand -hex 32
CALL_TICKET_SECRET=
